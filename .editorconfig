# Editor defaults matching the formatters (ruff format for Python, Biome for the monitor page).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
