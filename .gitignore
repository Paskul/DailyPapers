# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# Runtime data created by `paperwatch init` when the repo itself is used as the home directory.
# config.toml and topics.toml hold private research questions, so they are not committed.
/config.toml
/topics.toml
/state/
/output/

# Operator settings (installed into the paperwatch home by ./setup.sh). They hold private research
# questions and API keys, so only the examples and the README are committed.
/settings/*
!/settings/*.example.toml
!/settings/README.md
